# Supabase — Project Settings → API (or API Keys).
# Both values are public by design: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). A legacy "anon" JWT key also works,
# via NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public origin of the site, used for canonical URLs, the sitemap and every
# shared batch link (/production/<CODE>). Defaults to https://farms.zerod.bd.
# Set it on Vercel *preview* environments only if previews should share
# their own URLs instead of production ones.
NEXT_PUBLIC_SITE_URL=https://farms.zerod.bd

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to browsers) ---

# Secret key (sb_secret_…, or the legacy service_role key via
# SUPABASE_SERVICE_ROLE_KEY). Used ONLY by the nightly job that deletes
# videos past their retention period. It bypasses RLS: never give it a
# NEXT_PUBLIC_ name and never paste it into client code.
SUPABASE_SECRET_KEY=

# Random string protecting /api/cron/purge-expired-media. Vercel Cron sends
# it automatically. Generate one with: openssl rand -hex 32
CRON_SECRET=
