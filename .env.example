# Supabase — Project Settings → API (or API Keys).
# Both values are public by design: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). A legacy "anon" JWT key also works,
# via NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NEVER add the service-role / secret key here or anywhere in this app.
# Nothing in the codebase needs it.
